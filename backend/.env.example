# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=development

# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/shop

# Used only by the tests. Must be a separate database whose name ends in _test:
# the tests delete and recreate it on every run.
TEST_DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/shop_test

# Signs admin login tokens. Required, at least 32 characters, different on every
# server, and secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# How long an admin stays signed in
ACCESS_TOKEN_MINUTES=480

# Requests per minute allowed from one IP address
LOGIN_RATE_LIMIT=5
ORDER_RATE_LIMIT=10

# Folder for uploaded product photos (default: backend/data/uploads)
# UPLOAD_DIR=/var/lib/underground/uploads

DELIVERY_FEE=600
SHOP_TIMEZONE=Africa/Algiers

# Frontend origins allowed to call the API from a browser, comma-separated
CORS_ORIGINS=http://localhost:5173
